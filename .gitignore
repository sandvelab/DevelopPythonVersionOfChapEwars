__pycache__/
*.pyc
.DS_Store
.venv/
.env

# IDE and vault UI state — not part of the method.
.idea/
.vscode/
.obsidian/

# Personal working preferences, not method: permission grants specific to one machine and
# one operator, which change nothing about what the analysis does.
.claude/settings.local.json

# The analysis environment itself — rebuilt from environment/lock.txt by
# environment/install-env.sh. The specification and the lockfile are tracked; the build is not.
environment/env/
analysis/**/env/build/

# Derived and regenerable — rebuilt by /hierarchical-report. The contents are ignored
# rather than the directory, so that one file inside it can be kept: provenance.md is the
# append-only record of each build, written by hand and versioned like every other
# provenance record. A record of a build that is itself untracked records nothing.
AI-generated/hierarchical-report/*
!AI-generated/hierarchical-report/provenance.md

# Node working directories: scratch that a node's scripts or an external model runner
# create while running. Regenerated by the node's own run.sh.
analysis/**/work/

# The clean-room's scratch clone and its logs, if /validate cleanroom is set up to clone
# into the repository. The run's findings are copied to AI-generated/validation/, which is
# tracked; the clone itself is not.
AI-internal/useful-scripts/repo/
AI-internal/useful-scripts/*.log

# Large intermediates belong in a data store with content-addressed references, not in git
# history. Uncomment and adjust for this project's data:
# analysis/**/results/*.nc
# analysis/**/results/*.h5
# analysis/**/results/*.parquet

# Archived clones over ~50 MB: re-obtainable by commit from their provenance.md (plan §4, storage)
Archive/chap-core/src/

# The fitted INLA object inside a downloaded chapkit workspace (~37 MB): regenerable by
# re-running the node, and not read by anything downstream.
analysis/**/workspace/model.rds
