# The chap backtest settings for every chap evaluation in this project, R and Python alike
# (plan §4, "Backtest scheme"). Fixed in batch 2; changed only with a plan §4b entry.
# These are chap-core's own `chap eval` defaults (chap_core/cli_endpoints/evaluate.py).
# N_PERIODS equals the EWARS default `prediction_periods` (3).
N_PERIODS=3
N_SPLITS=7
STRIDE=1
# How chap fills in the covariates of each forecast window. "climatology" (chap-core's
# default) forecasts them per location from month/week of year; the observed future values
# are not passed. Every non-target column is treated as such a covariate (CH-07, JC-04).
FUTURE_WEATHER_PROVIDER=climatology
